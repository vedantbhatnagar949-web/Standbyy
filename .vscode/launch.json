{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "standby (Web - Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "args": [
                "--web-port=5050",
                "--web-browser-flag=--window-size=420,915"
            ]
        },
        {
            "name": "standby (Web Server)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "web-server",
            "args": [
                "--web-port=5050"
            ]
        }
    ]
}
